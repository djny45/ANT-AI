# ANT AI hosted development / production configuration
# Copy to .env and adjust for your environment.
# Never commit the real .env file or API keys.

# OpenRouter model runtime.
ANT_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT=20
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ANT AI

# Frontend → ANT API. Leave unset to use the same-origin /api route.
# VITE_ANT_API_URL=https://your-ant-api.example.com/api

# Comma-separated browser origins allowed to call the API.
ANT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Dedicated sandbox service. When set, coding/testing capabilities use this
# isolated service instead of the Vercel /tmp bounded fallback.
# Deploy sandbox/Dockerfile as a separate container and set both values in
# the ANT API environment; never expose the token to VITE_* variables.
ANT_SANDBOX_URL=
ANT_SANDBOX_TOKEN=
ANT_MAX_SANDBOX_TOOL_CALLS=3
ANT_SANDBOX_ROOT=/tmp/ant-sandbox
