# ANT AI local/cloud development configuration
# Copy to .env and adjust for your environment.
# Never commit the real .env file or API keys.

# Model runtime: ollama (local) or openrouter (hosted).
ANT_MODEL_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30

# OpenRouter hosted runtime.
# Use the free Nemotron route for development/evaluation only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT=60
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ANT AI

# Comma-separated browser origins allowed to call the API.
ANT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
