# ANT AI Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# API Configuration
# ============================================================================
ANT_API_KEY=your-secret-api-key-change-this-in-production
ANT_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite (default for development)
ANT_MEMORY_DATABASE_URL=sqlite:///./ant_memory.db

# PostgreSQL (for production)
# ANT_MEMORY_DATABASE_URL=postgresql://user:password@postgres:5432/ant_ai_db

# ============================================================================
# Frontend Configuration
# ============================================================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost/api

# ============================================================================
# Backend Configuration
# ============================================================================
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# ============================================================================
# LLM Configuration
# ============================================================================
# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# OpenRouter Configuration (alternative)
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-3.5-turbo

# ============================================================================
# Memory & Knowledge Configuration
# ============================================================================
KNOWLEDGE_HIVE_STORAGE_PATH=./data/knowledge_hive
MEMORY_CACHE_SIZE=1000
MEMORY_TTL=3600

# ============================================================================
# Security Configuration
# ============================================================================
# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# ============================================================================
# Monitoring & Logging Configuration
# ============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Docker & Deployment
# ============================================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_SWARM_INTELLIGENCE=true
ENABLE_SELF_IMPROVEMENT=true
ENABLE_BLOCKCHAIN_AUDIT=true
ENABLE_KNOWLEDGE_HIVE=true
