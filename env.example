# ANT AI Environment Configuration
# Copy this file to .env and fill in infrastructure values.
# Model API credentials are configured through the browser API profile UI.

# ============================================================================
# API Configuration
# ============================================================================
ANT_API_KEY=your-secret-api-key-change-this
ANT_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
ANT_MODEL_TIMEOUT=60

# ============================================================================
# Database Configuration
# ============================================================================
ANT_MEMORY_DATABASE_URL=sqlite:///./ant_memory.db
# ANT_MEMORY_DATABASE_URL=postgresql://user:password@postgres:5432/ant_ai_db

# ============================================================================
# Frontend / Backend Configuration
# ============================================================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost/api
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# ============================================================================
# Memory & Knowledge Configuration
# ============================================================================
KNOWLEDGE_HIVE_STORAGE_PATH=./data/knowledge_hive
MEMORY_CACHE_SIZE=1000
MEMORY_TTL=3600

# ============================================================================
# Security Configuration
# ============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# ============================================================================
# Monitoring & Logging Configuration
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Docker & Deployment
# ============================================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_SWARM_INTELLIGENCE=true
ENABLE_SELF_IMPROVEMENT=true
ENABLE_BLOCKCHAIN_AUDIT=true
ENABLE_KNOWLEDGE_HIVE=true

# Optional dedicated sandbox service
ANT_SANDBOX_URL=
ANT_SANDBOX_TOKEN=
ANT_MAX_SANDBOX_TOOL_CALLS=3
ANT_SANDBOX_ROOT=/tmp/ant-sandbox
