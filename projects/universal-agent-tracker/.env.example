# Use a long random password in production; never commit the real .env file.
POSTGRES_DB=uaat
POSTGRES_USER=uaat
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://uaat:replace-with-a-long-random-secret@db:5432/uaat

# Optional. Use a least-privilege token; never expose it to the browser.
GITHUB_TOKEN=

# Bind locally; use an authenticated TLS reverse proxy for public access.
HOST=0.0.0.0
PORT=8000
DISCOVERY_INTERVAL_MINUTES=30
ENDPOINT_CHECK_INTERVAL_MINUTES=5
GITHUB_SEARCH_QUERY=topic:ai-agent
