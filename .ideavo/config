{
  "systemSetup": [
    {
      "name": "Install Java",
      "command": "curl -s \"https://get.sdkman.io\" | bash && bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && sdk install java 17.0.12-tem\""
    },
    {
      "name": "Install Android SDK",
      "command": "mkdir -p \"$HOME/android-sdk/cmdline-tools\" && curl -fsSL \"https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip\" -o /tmp/android-cmdline-tools.zip && unzip -q /tmp/android-cmdline-tools.zip -d \"$HOME/android-sdk/cmdline-tools\" && rm -rf \"$HOME/android-sdk/cmdline-tools/latest\" && mv \"$HOME/android-sdk/cmdline-tools/cmdline-tools\" \"$HOME/android-sdk/cmdline-tools/latest\" && bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && yes | \\\"$HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager\\\" --sdk_root=\\\"$HOME/android-sdk\\\" --licenses && \\\"$HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager\\\" --sdk_root=\\\"$HOME/android-sdk\\\" \\\"platform-tools\\\" \\\"platforms;android-35\\\" \\\"build-tools;35.0.0\\\"\""
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Resolve Dependencies",
      "command": "bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && cd android_app && ./gradlew --no-daemon dependencies\""
    }
  ],
  "codeChecks": [
    {
      "name": "Run Checks",
      "command": "bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && cd android_app && ./gradlew --no-daemon check\""
    }
  ],
  "buildSteps": [
    {
      "name": "Build Debug APK",
      "command": "bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && cd android_app && ./gradlew --no-daemon assembleDebug\""
    }
  ],
  "runStep": [],
  "deploySteps": [
    {
      "name": "Build Release APK",
      "command": "bash -lc \"source \\\"$HOME/.sdkman/bin/sdkman-init.sh\\\" && cd android_app && ./gradlew --no-daemon assembleRelease\""
    }
  ],
  "cleanupFiles": [
    ".env",
    ".ideavo/config",
    ".ideavo/template",
    "android_app/.gradle",
    "android_app/local.properties",
    "android_app/build",
    "android_app/app/build"
  ],
  "packageManager": "gradle",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
